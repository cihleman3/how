#!/usr/bin/env bash
# Starts how. The arguments arrive unchanged.

# how.jar is next to this script (installation for all users) or in ~/.local/share/how (for one user).
self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
jar="$self_dir/how.jar"
[[ -f "$jar" ]] || jar="$HOME/.local/share/how/how.jar"

# Java from JAVA_HOME, otherwise from the PATH.
java=java
if [[ -n "${JAVA_HOME:-}" ]]; then
  java_home="$JAVA_HOME"
  command -v cygpath > /dev/null && java_home="$(cygpath -u "$java_home")"
  [[ -x "$java_home/bin/java" ]] && java="$java_home/bin/java"
fi
if ! command -v "$java" > /dev/null; then
  echo "how: Java not found. Install Java 17 or newer, or set JAVA_HOME." >&2
  exit 1
fi

if command -v cygpath > /dev/null; then
  # Git Bash. Both variables apply to java only; how does not pass them on to the commands it runs:
  # MSYS_NO_PATHCONV: do not rewrite words like /etc in the question into Windows paths.
  # HOW_BASH: the bash that started how, so that how does not pick the WSL launcher in System32 when running a command.
  HOW_BASH="$(cygpath -w "$BASH")" MSYS_NO_PATHCONV=1 \
    exec "$java" -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -jar "$(cygpath -w "$jar")" "$@"
fi
exec "$java" -jar "$jar" "$@"
